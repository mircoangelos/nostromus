# File System
REPORTS_DIR=reports
LOGS_DIR=logs

# API
API_PORT=4000
API_URL=http://localhost:4000

# Frontend
REACT_APP_API_URL=http://localhost:4000
REACT_APP_KEYCLOAK_URL=http://localhost:8080

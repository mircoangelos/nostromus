# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=react-keycloak
KEYCLOAK_CLIENT_ID=FE-keycloak
KEYCLOAK_CLIENT_SECRET=your-client-secret

# Database
DATABASE_URL=postgresql://keycloak:keycloakpassword@localhost:5432/keycloak

# AI Agent (Gemini)
